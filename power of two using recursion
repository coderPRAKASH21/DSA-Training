#include<stdio.h>

void result(int power, int sum){
    if(power<1)
    {
        printf("sum: %d",sum);
        return;
    }
    else
    {
        sum = sum*2;
        result(power-1 , sum);
    }
}

int main(){
    int power;
    int sum = 1;
    printf("Enter the power of Two: ");
    scanf("%d",&power);
    result(power, sum);
    return 0;
}
